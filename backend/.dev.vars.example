# Copy to .dev.vars (git-ignored) and fill in at least one key.
# Each provider gets its own key for this project, so PR Lens has its own free quota.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: fallback order and model overrides.
# LLM_PROVIDERS=gemini,groq,openrouter
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
