{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pr-lens-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // PR details and LLM analyses, keyed by head commit. No id: wrangler dev uses local
  // storage, and wrangler deploy creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "CACHE" }],
  "vars": {
    // PR Lens's Chrome Web Store ID. Local builds get the same ID: the "key" in
    // extension/manifest.json is the store's public key.
    "ALLOWED_EXTENSION_IDS": "kpnecmaddfhjedpoohbndleebhepokdo"
  }
}
