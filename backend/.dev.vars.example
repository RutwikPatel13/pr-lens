# Copy to .dev.vars (git-ignored) and fill in at least one key.
# Each provider gets its own key for this project, so PR Lens has its own free quota.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: fallback order and model overrides.
# LLM_PROVIDERS=groq,groq:openai/gpt-oss-20b,gemini,openrouter   (entries: name or name:model)
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
