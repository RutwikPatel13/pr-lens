{
  "manifest_version": 3,
  "name": "PR Lens",
  "version": "0.1.0",
  "description": "Explains GitHub pull requests to the person reviewing them.",
  "action": {
    "default_title": "Open PR Lens"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://github.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open PR Lens"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
